{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "feeds",
  "version": "0.2.0",
  "identifier": "com.phagenlocher.feeds",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Feeds",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/64x64.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
